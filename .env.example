# Copy to .env (scripts/bootstrap.sh does this and generates a real RCON password).
# .env is gitignored — never commit it.

# --- image + game version ---------------------------------------------
# Two independent things, both pinned:
#   MC_IMAGE   the container tooling (itzg), date-tagged YYYY.M.P
#   MC_VERSION the game itself. Mojang switched to year.drop[.hotfix] in
#              2026, so the order is 1.21.x -> 26.1 -> 26.2, not 1.x.
#
# Pin these. `latest`/`LATEST` is not just non-reproducible: loading a
# world on a newer game version silently upgrades its chunk format, and
# that is NOT reversible. An unattended `docker compose pull` is a
# one-way door with no rollback except restoring a backup.
MC_IMAGE=itzg/minecraft-server:2026.8.1
MC_VERSION=26.2

# --- resources ---------------------------------------------------------
# JVM heap. Keep comfortably BELOW MC_MEM_LIMIT (JVM off-heap counts too).
MC_MEMORY=1500M
MC_MEM_LIMIT=2g
# The tick loop is single-threaded, but Paper offloads chunk generation and
# I/O to other threads and the JVM wants a core for GC. 1 starves those.
MC_CPUS=2

# --- gameplay ----------------------------------------------------------
MC_MAX_PLAYERS=10
MC_MOTD=Minecraft server
MC_DIFFICULTY=normal

# --- performance -------------------------------------------------------
# View distance = how far players SEE. Costs bandwidth and RAM, not tick
# time. Cosmetic only — farms don't care. Caps the client's own slider.
MC_VIEW_DISTANCE=8
#
# Simulation distance = how far the world TICKS, and 8 is the farm-safe
# floor. Mob spawning uses a 128-block (= 8 chunk) sphere around each
# player; anything lower clips that sphere and starves mob farms, and
# stops redstone/hoppers/crops the moment you walk away. Don't lower this
# to save CPU — raise MC_CPUS instead.
MC_SIMULATION_DISTANCE=8

# --- rcon --------------------------------------------------------------
# Used by scripts/backup.sh for save-off/save-on. Port is never published.
MC_RCON_PASSWORD=changeme
