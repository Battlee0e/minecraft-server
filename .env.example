# Copy to .env (scripts/bootstrap.sh does this and generates a real RCON password).
# .env is gitignored — never commit it.

# --- image + game version ---------------------------------------------
# Two independent things, both pinned:
#   MC_IMAGE   the container tooling (itzg), date-tagged YYYY.M.P
#   MC_VERSION the game itself. Mojang switched to year.drop[.hotfix] in
#              2026, so the order is 1.21.x -> 26.1 -> 26.2, not 1.x.
#
# Pin these. `latest`/`LATEST` is not just non-reproducible: loading a
# world on a newer game version silently upgrades its chunk format, and
# that is NOT reversible. An unattended `docker compose pull` is a
# one-way door with no rollback except restoring a backup.
MC_IMAGE=itzg/minecraft-server:2026.8.1
MC_VERSION=26.2

# --- resources ---------------------------------------------------------
# Sized for a 16 GB VPS shared with other containers. Two rules set these:
#
#   MC_MEMORY  ~70-75% of MC_MEM_LIMIT. The JVM's off-heap usage (metaspace,
#              thread stacks, direct buffers, GC structures) counts toward the
#              container limit, so setting them close means Docker OOM-kills
#              the container while the heap still looks healthy.
#   MC_MEM_LIMIT  what you're willing to hand this one container, leaving room
#              for the host and anything else on the box.
#
# The gap between the two is not slack you can reclaim. A 1500M heap under a
# 2g limit — 73%, inside the rule — still died: the JVM reached 2.04 GB RSS
# with two players exploring and the kernel killed it mid-session. The heap
# never looked full, because the overrun was off-heap. If the container is
# OOM-killed, raise MC_MEM_LIMIT first and MC_MEMORY only after.
#
# Bigger is not better past that point: an oversized heap makes G1 pauses
# longer, not shorter, and hides leaks until they're huge. 4G is generous for
# 10 players and there is no reason to go further on this world.
MC_MEMORY=4G
MC_MEM_LIMIT=6g
# The tick loop is single-threaded, so a third core cannot make ticks faster.
# 2 exists so Paper's chunk gen/IO threads and the JVM's GC threads aren't
# fighting the tick thread for the one core that matters; 1 starves those.
# Only consider 3 if players stutter *while exploring new terrain* and the
# box has 4+ cores to spare.
MC_CPUS=2

# --- gameplay ----------------------------------------------------------
MC_MAX_PLAYERS=10
MC_MOTD=Minecraft server
MC_DIFFICULTY=normal

# --- performance -------------------------------------------------------
# View distance = how far players SEE. Costs bandwidth and RAM, not tick
# time. Cosmetic only — farms don't care. This is a CEILING: each client's
# own slider picks anything up to it, never past it.
#
# Cost is (2n+1)² chunks per player: 8 -> 289, 12 -> 625, 16 -> 1089,
# 32 (the server max) -> 4225. But chunks are loaded ONCE and shared, so the
# driver is how far apart players roam, not the headcount — two players
# together cost about what one does.
#
# 16 suits a small group playing near each other and is past where most
# clients set their own slider anyway. If everyone splits up to explore and
# the heap gets tight, raise MC_MEMORY to 2500M and MC_MEM_LIMIT to 3g.
# Above ~20 fog and culling eat the gain; 32 will OOM this box.
MC_VIEW_DISTANCE=16
#
# Simulation distance = how far the world TICKS, and 8 is the farm-safe
# floor. Mob spawning uses a 128-block (= 8 chunk) sphere around each
# player; anything lower clips that sphere and starves mob farms, and
# stops redstone/hoppers/crops the moment you walk away. Don't lower this
# to save CPU — raise MC_CPUS instead.
MC_SIMULATION_DISTANCE=8

# --- rcon --------------------------------------------------------------
# Used by scripts/backup.sh for save-off/save-on. Port is never published.
MC_RCON_PASSWORD=changeme
